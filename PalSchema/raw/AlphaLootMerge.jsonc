{
    "DT_PalDropItem": {
        // ---------------------------------------------------------------
        // Alpha Pals drop their normal counterpart's loot as well.
        //
        // Palworld already copies a normal Pal's loot into its Alpha row and
        // sets the drop chance to 0. This mod turns those chances back on to
        // whatever the normal Pal uses, so an Alpha gives you its own loot
        // plus everything its normal counterpart drops.
        //
        // For most rows that means changing a percentage and nothing else, the
        // game has already placed the right item in the right slot. Where the
        // Alpha row ran out of room and never received an item, it is added
        // whole into a slot that was empty.
        //
        // The lines marked "vanilla" are notes, not changes. They show what the
        // Alpha already drops so you can see what this mod is adding.
        //
        // Nothing that already drops is removed. Slot 10 is never written, so
        // this can run alongside the Pals Drop Dog Coins mod.
        // ---------------------------------------------------------------

        // Melpaca
        "BOSS_Alpaca000": {
            // vanilla: PalCrystal_Ex  100%  x1-2  (slot 1)
            // vanilla: PalItem_ToSell_05  100%  x1-2  (slot 4)
            // Wool: 0% -> 100%   (already in slot 2, rate only)
            "Rate2": 100,
            // Leather: 0% -> 100%   (already in slot 3, rate only)
            "Rate3": 100
        },
        // Kitsun
        "BOSS_AmaterasuWolf000": {
            // vanilla: PalCrystal_Ex  100%  x6-8  (slot 1)
            // vanilla: PalItem_ToSell_05  100%  x6-8  (slot 4)
            // FireOrgan: 0% -> 100%   (already in slot 2, rate only)
