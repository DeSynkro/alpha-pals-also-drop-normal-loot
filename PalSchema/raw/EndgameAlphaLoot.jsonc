{
    "DT_PalDropItem": {
        // ---------------------------------------------------------------
        // The same merge, applied above level 0.
        //
        // Two groups live here. The World Tree bosses at level 70 are packed:
        // the five Ancient Relic drops take up most of the slots and slot 10
        // is already in use, so there is nowhere to add an item and every
        // change is a percentage on a slot the game had switched off. Anything
        // that has no free slot is left out rather than written over a relic.
        //
        // The MimicDog ladder at levels 10 to 50 has room, so those rows do get
        // items added.
        //
        // The relic ladder and the Ancient Civilization Parts are untouched.
        // ---------------------------------------------------------------

